  "axes": {
    "morphology": {
      "shortTitle": "Формообразование",
      "title": "Морфология",
      "hint": "Скульптура, мутация, ландшафт",
      "text": "Язык формы: от историчных силуэтов и барочной театральности до мутирующих ландшафтных форм и скульптурной мебели. Как рождается форма — из истории, из природы или из чистой геометрии."
    },
    "colors": {
      "shortTitle": "Цвета",
      "title": "Интенсивность, температура, характер",
      "text": "Генеральные позиции цвета: интенсивность (яркие, приглушённые), температура (тёплые, холодные), место цвета в орнаменте. Минеральная палитра 2026 — терракота, охра, известняк; акценты — оливковый и вишнёвый."
    },
    "ornaments": {
      "shortTitle": "Орнаменты",
      "title": "Узор как осмысленный выбор",
      "hint": "Геометричные, растительные, гибридные",
      "text": "Геометрические или растительные? Или и те, и другие вместе. Переосмысление орнаментики из Ар-деко, фольклорных мотивов и традиционных ремесленных паттернов."
    },
    "textures": {
      "shortTitle": "Текстуры",
      "title": "Тактильность и столкновение фактур",
      "hint": "«Тач-тач-тач», множество фактур",
      "text": "Тенденция к обилию фактур в едином пространстве. Столкновение разных по тактильности материалов — фольклорный текстиль рядом с камнем, вафельный лён рядом с кожей. Задержаться в телесном опыте."
    },
    "materials": {
      "shortTitle": "Материалы",
      "title": "Честность сырья без имитаций",
      "hint": "Камень, дерево, металл, стекло, лён",
      "text": "Природное сырьё без имитаций: необработанный травертин, массив палисандра, вафельный лён, кованый металл, застывшее стекло. Марцин Русак (Flower Infused Glass), Facultative Works (металл как органическая складка)."
    },
    "technologies": {
      "shortTitle": "Технологии",
      "title": "Крафт, 3D-печать и ручные техники",
      "text": "Соединение ремесленного крафта и высоких технологий: 3D-печать, биомимикрия, переосмысление традиционных технологий. Артизаны как мост между хай-теком и ручным трудом."
    },
    "philosophy": {
      "shortTitle": "Философия времени",
      "title": "Идеология и философия времени и места",
      "hint": "Деглобализация, экология, мета-модерн",
      "text": "Идеология, философия времени и географической точки: деглобализация, устойчивое развитие, замедление перепроизводства, локальная идентичность."
    }
  },

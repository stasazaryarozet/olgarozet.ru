  "axes": {
    "morphology": {
      "shortTitle": "Формообразование",
      "title": "Морфология",
      "hint": "Скульптура, мутация, ландшафт",
      "text": "Язык формы: от историчных силуэтов и барочной театральности до мутирующих ландшафтных форм и скульптурной мебели. Как рождается форма — из истории, из природы или из чистой геометрии."
    },
    "colors": {
      "shortTitle": "Цвета",
      "title": "Интенсивность, температура, характер",
      "hint": "Яркие vs приглушённые, тёплые vs холодные",
      "text": "Не перечень конкретных цветов, а генеральные позиции: интенсивность (яркие, приглушённые), температура (тёплые, холодные), место цвета в орнаменте. Минеральная палитра 2026: терракота, охра, известняк."
    },
    "ornaments": {
      "shortTitle": "Орнаменты",
      "title": "Геометрия и растительность",
      "hint": "Геометричные, растительные, гибридные",
      "text": "Геометрические или растительные? Или присутствуют оба — и можно выбирать. Переосмысление орнаментики из Ар-деко, фольклорных мотивов и традиционных ремесленных паттернов."
    },
    "textures": {
      "shortTitle": "Текстуры",
      "title": "Тактильность и столкновение фактур",
      "hint": "Тач-тач-тач, множество фактур",
      "text": "Тренд на огромное количество текстур в одном месте. Столкновение разных по тактильности материалов — фольклорный текстиль рядом с камнем, вафельный лен рядом с кожей. Задержаться в телесном опыте."
    },
    "materials": {
      "shortTitle": "Материалы",
      "title": "Честность сырья без имитаций",
      "hint": "Камень, дерево, металл, стекло, лён",
      "text": "Природное сырье без имитаций: необработанный травертин, массив палисандра, вафельный лен, кованый металл, застывшее стекло. Марцин Русак (Flower Infused Glass), Facultative Works (металл как органическая складка)."
    },
    "technologies": {
      "shortTitle": "Технологии",
      "title": "Craft, 3D-печать и ручные техники",
      "hint": "Craft, 3D, ремесло + высокие технологии",
      "text": "Соединение ремесленного craft и высоких технологий: 3D-печать, биомимикрия, переосмысление традиционных технологий. Артизаны как мост между хай-теком и ручным трудом."
    },
    "philosophy": {
      "shortTitle": "Философия времени",
      "title": "Идеология и философия времени и места",
      "hint": "Деглобализация, экология, мета-модерн",
